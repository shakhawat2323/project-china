import { notFound } from "next/navigation";
import { Metadata } from "next";
import { PageService } from "@/services/page.service";
import { getNavPageBySlug } from "@/lib/navigation";
import { FileText } from "lucide-react";

export async function generateMetadata({ params }: { params: { sectionSlug: string; pageSlug: string } }): Promise<Metadata> {
  const res = await PageService.getPageBySlug(params.sectionSlug, params.pageSlug);
  const page = res?.data;

  // Fallback to static dictionary titles if DB page isn't found
  const staticPage = getNavPageBySlug(params.sectionSlug, params.pageSlug);

  return {
    title: page?.metaTitle || page?.title || staticPage?.pageTitle || "Page Not Found",
    description: page?.metaDescription || `Information about ${staticPage?.pageTitle || params.pageSlug}`,
  };
}

export default async function DynamicCmsPage({ params }: { params: { sectionSlug: string; pageSlug: string } }) {
  const res = await PageService.getPageBySlug(params.sectionSlug, params.pageSlug);
  const page = res?.data;
  const staticPage = getNavPageBySlug(params.sectionSlug, params.pageSlug);

  if (!page) {
    if (!staticPage) {
      // It's not in the DB and not in our navigation tree -> true 404
      notFound();
    }
    
    // It is in our navigation tree, but the admin hasn't added content in the CMS yet.
    return (
      <div className="bg-background min-h-[60vh] flex flex-col items-center justify-center px-4">
        <div className="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-primary/10 mb-6">
          <FileText className="h-8 w-8 text-primary" />
        </div>
        <h1 className="text-3xl font-bold text-foreground mb-4">{staticPage.pageTitle}</h1>
        <p className="text-lg text-muted-foreground max-w-lg text-center">
          We are currently updating our documentation and policies. The content for {staticPage.pageTitle} will be available here soon.
        </p>
      </div>
    );
  }

  return (
    <div className="bg-background min-h-screen py-20">
      <div className="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <div className="mb-12 border-b border-border/50 pb-8">
          <p className="text-sm font-semibold uppercase tracking-[0.2em] text-primary/70 mb-3">
            {page.sectionSlug.replace("-", " ")}
          </p>
          <h1 className="text-4xl font-extrabold tracking-tight text-foreground sm:text-5xl">
            {page.title}
          </h1>
          {page.updatedAt && (
            <p className="mt-4 text-sm text-muted-foreground">
              Last updated: {new Date(page.updatedAt).toLocaleDateString()}
            </p>
          )}
        </div>

        {page.content && (
          <div 
            className="prose prose-lg dark:prose-invert max-w-none prose-headings:font-bold prose-a:text-primary hover:prose-a:text-primary/80"
            dangerouslySetInnerHTML={{ __html: page.content }}
          />
        )}
        
        {/* Render FAQs if available */}
        {page.faqs && Array.isArray(page.faqs) && page.faqs.length > 0 && (
          <div className="mt-16 border-t border-border/50 pt-12">
            <h2 className="text-2xl font-bold mb-8 text-foreground">Frequently Asked Questions</h2>
            <div className="space-y-6">
              {page.faqs.map((faq: any, index: number) => (
                <div key={index} className="bg-muted/30 p-6 rounded-lg">
                  <h3 className="text-lg font-semibold text-foreground mb-2">{faq.question}</h3>
                  <p className="text-muted-foreground">{faq.answer}</p>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  );
}
